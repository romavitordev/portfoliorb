// Banco do site — hoje só guarda leads.
//
// Produção: Postgres (Neon), como no Marcelo Imóveis.
// Desenvolvimento: SQLite, sem instalar nada — `npm run db:dev` deriva
// deste arquivo um schema.dev.prisma trocando só o provider. Fonte única
// de verdade continua sendo ESTE arquivo.
//
// Duas escolhas que mantêm os dois bancos compatíveis:
//
// 1. `status` é String, não enum. Enum do Postgres exige ALTER TYPE para
//    cada valor novo e não existe no SQLite. Os valores válidos vivem em
//    lib/lead-status.ts e são impostos pelo Zod na fronteira da API.
// 2. Sem `@db.Text`: no Postgres o Prisma já mapeia String para `text`
//    por padrão, então o atributo era redundante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Sócios com acesso ao painel. Criados por `npm run usuario`.
model Usuario {
  id    String @id @default(cuid())
  email String @unique
  nome  String

  /// scrypt, formato "sal:hash" (lib/senha.ts). Nunca em texto puro.
  senhaHash String

  /// Segredo do TOTP CIFRADO em AES-256-GCM (lib/totp.ts).
  /// Não pode ser hash: o servidor precisa dele em claro para calcular o
  /// código esperado. Cifrado com chave derivada do ADMIN_JWT_SECRET,
  /// que mora fora do banco — um dump sozinho não gera códigos válidos.
  totpSegredo String?
  /// Só quando o usuário confirma o primeiro código é que a 2FA passa a
  /// ser exigida. Evita trancar alguém que escaneou o QR e desistiu.
  totpAtivoEm DateTime?

  ultimoLogin DateTime?
  criadoEm    DateTime  @default(now())
}

model Lead {
  id       String   @id @default(cuid())
  nome     String
  contato  String // WhatsApp ou e-mail — como a pessoa quer ser respondida
  tipo     String // o que precisa (ver `contato.tipos` em lib/site.ts)
  prazo    String
  sobre    String
  /// Um de STATUS_LEAD (lib/lead-status.ts). Validado pelo Zod na API.
  status   String   @default("NOVO")
  /// Anotação interna do estúdio — nunca sai em rota pública.
  nota     String?
  /// De qual página veio, para saber o que converte.
  origem   String?
  criadoEm DateTime @default(now())

  /// Quem mexeu por último — nome do sócio, para saber quem já falou com
  /// o lead sem precisar de join.
  tratadoPor String?
  tratadoEm  DateTime?

  @@index([status, criadoEm])
  @@index([criadoEm])
}
