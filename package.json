{
  "name": "roma-buganza",
  "version": "1.0.0",
  "private": true,
  "description": "Roma & Buganza — estúdio de desenvolvimento. Sites, landing pages, sistemas web e produtos digitais.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:dev": "node scripts/schema-dev.mjs && prisma db push --schema prisma/schema.dev.prisma --skip-generate && prisma generate --schema prisma/schema.dev.prisma",
    "senha": "node scripts/gerar-hash.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^11.11.0",
    "gsap": "^3.12.5",
    "jose": "^6.2.8",
    "lenis": "^1.1.14",
    "lucide-react": "^0.460.0",
    "next": "^14.2.5",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
