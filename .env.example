# Copie para .env e preencha. Nunca versione o .env.

# ---------------------------------------------------------------
# Banco — Postgres. Recomendado: Neon (neon.tech), plano gratuito.
# ---------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------
# Painel /admin
# ---------------------------------------------------------------
# Segredo de assinatura da sessão. Mínimo 32 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ATENÇÃO: este mesmo segredo cifra o segredo da 2FA no banco. Trocá-lo
# depois que alguém ativou a 2FA torna os códigos indecifráveis, e a
# pessoa precisa reativar. Guarde bem.
ADMIN_JWT_SECRET=""

# Não existe senha em variável de ambiente: cada sócio tem a própria
# conta no banco. Crie com:
#   npm run usuario -- "vitor@romabuganza.com.br" "Vitor Roma" "senha-forte"

# ---------------------------------------------------------------
# E-mail de aviso de lead novo — Resend (resend.com), 3.000/mês grátis
# ---------------------------------------------------------------
# Sem estas variáveis o site funciona: o lead é salvo e o aviso vai
# só para o log do servidor.
RESEND_API_KEY=""
# Para onde vai o aviso. Aceita vários separados por vírgula.
EMAIL_DESTINO="vitor@exemplo.com,marcelo@exemplo.com"
# Remetente. Precisa de domínio verificado no Resend; até lá, use o
# endereço de teste abaixo.
EMAIL_REMETENTE="Site Roma & Buganza <onboarding@resend.dev>"

# ---------------------------------------------------------------
# Captação de leads
# ---------------------------------------------------------------
# "off" faz o formulário cair direto no WhatsApp, sem chamar a API.
# É o que o espelho estático (layout_portfoliorb) usa.
# NEXT_PUBLIC_LEADS="off"
